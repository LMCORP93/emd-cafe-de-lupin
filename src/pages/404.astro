---
import config from '@/data/site.config';
const analyticsMeasurementId = config.analyticsMeasurementId;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page introuvable | Café de Lupin</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&display=swap" rel="stylesheet" />
    {analyticsMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsMeasurementId}`}></script>
        <script is:inline define:vars={{ analyticsMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', analyticsMeasurementId);
        </script>
      </>
    )}
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Archivo', sans-serif; background: #faf8f5; color: #242424; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem; text-align: center; }
      .wrap { max-width: 480px; }
      .code { font-size: clamp(4rem, 10vw, 6rem); font-weight: 700; color: #ef7a1a; line-height: 1; }
      h1 { font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 700; margin: 1rem 0 0.75rem; }
      p { font-size: 1rem; color: #666; line-height: 1.6; margin-bottom: 2rem; }
      a { display: inline-flex; align-items: center; gap: 0.5rem; background: #ef7a1a; color: #fff; font-weight: 600; font-size: 0.9375rem; padding: 0.75rem 1.75rem; border-radius: 0.5rem; text-decoration: none; transition: background 0.2s; }
      a:hover { background: #d66a12; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="code">404</div>
      <h1>Page introuvable</h1>
      <p>La page que vous cherchez n'existe pas ou a été déplacée.</p>
      <a href="/">
        Retour à l'accueil
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </body>
</html>
